{
    "name": "icon-nail-salon",

    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        }
    },

    "forwardPorts": [
        3000,
        3001
    ],

    "postCreateCommand": "python -m pip install --upgrade pip && pip install pipenv && pipenv install --dev && npm install",

    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "ms-python.autopep8"
            ]
        }
    }
}